{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime-guide.schema.json",
  "title": "実行環境・サーバー構築ガイドの手順（docs/11-v090-runtime-guide.md 2.4。型は src/features/runtime-guide/types.ts）",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "title", "summary", "order", "os", "params", "steps"],
  "definitions": {
    "os": { "enum": ["rhel9", "al2023", "windows"] },
    "osList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/os" }
    },
    "condition": {
      "description": "'tls' / '!tls' / 'winNodeTool=fnm' / 'winNodeTool!=fnm'",
      "type": "string",
      "pattern": "^!?[A-Za-z][A-Za-z0-9]*((!?=)[A-Za-z0-9._-]*)?$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 600 },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "explain": { "$ref": "#/definitions/text" },
        "shell": { "enum": ["bash", "powershell"] },
        "os": { "$ref": "#/definitions/osList" },
        "when": { "$ref": "#/definitions/condition" },
        "e2e": {
          "description": "false: コンテナで手順を流す検査（npm run test:runtime）で実行しない（対話的なコマンド・サービスの再起動・アプリのフォルダが要るものなど）",
          "const": false
        }
      }
    },
    "file": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator"],
          "properties": {
            "generator": {
              "enum": [
                "nginx-conf",
                "systemd-spring",
                "tomcat-setenv",
                "tomcat-server-xml",
                "systemd-tomcat"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "language", "lines"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "language": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "comment": { "type": "string", "minLength": 1, "maxLength": 4 },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "maxLength": 2000 },
                  "explain": { "$ref": "#/definitions/text" },
                  "when": { "$ref": "#/definitions/condition" },
                  "os": { "$ref": "#/definitions/osList" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "version": { "const": 1 },
    "topic": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "order": { "type": "integer", "minimum": 0 },
    "os": { "$ref": "#/definitions/osList" },
    "params": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "why": { "$ref": "#/definitions/text" },
          "danger": { "$ref": "#/definitions/text" },
          "pitfalls": { "type": "array", "items": { "$ref": "#/definitions/text" } },
          "os": { "$ref": "#/definitions/osList" },
          "when": { "$ref": "#/definitions/condition" },
          "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } },
          "file": { "$ref": "#/definitions/file" },
          "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } },
          "goto": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "pitfalls": { "type": "array", "items": { "$ref": "#/definitions/text" } },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      }
    }
  }
}
