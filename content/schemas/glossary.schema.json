{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "glossary.schema.json",
  "title": "技術用語図鑑（分類ごとに 1 ファイル）",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "terms"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "category": {
      "enum": ["general", "java", "python", "javascript", "ruby", "git", "linux", "vscode"]
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "term", "summary"],
        "properties": {
          "id": {
            "description": "一意な ID（kebab-case。ファイルをまたいで重複しない）",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "term": { "type": "string", "minLength": 1, "maxLength": 40 },
          "reading": { "description": "読み（任意）", "type": "string", "minLength": 1 },
          "summary": {
            "description": "短い説明（1〜3 文。答えを与えすぎない）",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aliases": {
            "description": "別名（検索用。例: NPE）",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "keywords": {
            "description": "照合用キーワード。タイピングのお題などに含まれていたら発見にする（大文字小文字を区別、英数字の前後は単語の区切りで判定）",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "related": {
            "description": "関連する用語の ID",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "features": {
            "description": "関連する機能の ID（例: error-dict、cheatsheet、git-dict）",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "url": {
            "description": "公式ドキュメントの URL（https のみ。社内 URL は書かない）",
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
