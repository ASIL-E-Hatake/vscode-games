{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "output-quiz.schema.json",
  "title": "出力当てクイズの問題（言語ごとに 1 ファイル。quiz-kit 共通の形式）",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "questions"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "language": {
      "enum": ["java", "python", "javascript", "ruby"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "difficulty", "code", "answer", "choices", "explanation"],
        "properties": {
          "id": {
            "description": "<言語>-<内容>（例: python-int-division）",
            "type": "string",
            "pattern": "^(java|python|javascript|ruby)(-[a-z0-9]+)+$"
          },
          "title": {
            "description": "問題の短い名前（結果画面の「間違えた問題」に出す。答えを含めない）",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "difficulty": {
            "enum": ["easy", "normal", "hard"]
          },
          "code": {
            "description": "表示するコード。npm run test:snippets で実行し、標準出力が answer と一致することを確かめる",
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "description": "正解の出力（各行の末尾の空白と最後の改行は比べない）",
            "type": "string"
          },
          "choices": {
            "description": "誤答の選択肢（3 つ）。正解・ほかの選択肢と同じ出力にしない",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output"],
              "properties": {
                "output": {
                  "type": "string"
                },
                "note": {
                  "description": "よくある勘違いの説明（この選択肢を選んだときに表示する）",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "explanation": {
            "description": "なぜその答えになるか（どこでどう値が変わるか）",
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "description": "関連する技術用語図鑑の用語 ID（content/glossary）。回答すると図鑑で発見済みになる",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "secret": {
            "description": "シークレット問題（隠し問題）。true にすると通常の出題には出ず、unlock の条件を満たしたプレイの最後にボーナス問題として出る",
            "const": true
          },
          "unlock": {
            "description": "シークレット問題の出現条件（secret: true のとき必須）。perfect: そのプレイの通常の問題を全問正解 / glossary: 技術用語図鑑の収集率が percent% 以上 / time: 時刻が from 以上 to 未満（\"HH:MM\"。to が from より前なら日付をまたぐ）",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "perfect"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "percent"],
                "properties": {
                  "type": {
                    "const": "glossary"
                  },
                  "percent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "from", "to"],
                "properties": {
                  "type": {
                    "const": "time"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                  }
                }
              }
            ]
          }
        },
        "dependencies": {
          "secret": ["unlock"],
          "unlock": ["secret"]
        }
      }
    }
  }
}
