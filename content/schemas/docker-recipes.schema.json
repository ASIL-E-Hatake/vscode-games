{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docker-recipes.schema.json",
  "title": "Docker 困ったとき辞書（症状から引くレシピ）",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "situation", "command", "explanation", "pitfall"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "category": {
            "description": "start: 起動しない / connect: 繋がらない / build: ビルド / data: データ・ボリューム / cleanup: 片付け・容量 / desktop: Windows・Docker Desktop",
            "enum": ["start", "connect", "build", "data", "cleanup", "desktop"]
          },
          "situation": { "type": "string", "minLength": 1, "maxLength": 60 },
          "command": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "pitfall": { "type": "string", "minLength": 1 },
          "danger": {
            "description": "取り返しがつかない操作の注意文。画面で目立つ注意表示になる",
            "type": "string",
            "minLength": 1
          },
          "related": {
            "description": "関連するレシピの id",
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
