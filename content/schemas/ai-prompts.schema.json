{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-prompts.schema.json",
  "title": "AI への依頼文テンプレート",
  "type": "object",
  "additionalProperties": false,
  "required": ["templates"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "title", "summary", "fields", "output"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "category": { "enum": ["develop", "investigate", "analyze", "write", "learn"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
          "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "type", "why"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "label": { "type": "string", "minLength": 1 },
                "type": { "enum": ["text", "textarea", "select", "checkbox"] },
                "required": { "type": "boolean" },
                "placeholder": { "type": "string" },
                "why": { "type": "string", "minLength": 1 },
                "text": {
                  "description": "checkbox: チェックしたときに {{id}} へ入る文",
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "description": "select: 選択肢。value が {{id}} へ入る文（空なら「指定なし」）",
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "value"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1 },
                      "value": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "output": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
