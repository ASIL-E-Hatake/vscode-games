{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "output-quiz.schema.json",
  "title": "出力当てクイズの問題（言語ごとに 1 ファイル。quiz-kit 共通の形式）",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "questions"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "language": { "enum": ["java", "python", "javascript", "ruby"] },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "difficulty", "code", "answer", "choices", "explanation"],
        "properties": {
          "id": {
            "description": "<言語>-<内容>（例: python-int-division）",
            "type": "string",
            "pattern": "^(java|python|javascript|ruby)(-[a-z0-9]+)+$"
          },
          "title": {
            "description": "問題の短い名前（結果画面の「間違えた問題」に出す。答えを含めない）",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "difficulty": { "enum": ["easy", "normal", "hard"] },
          "code": {
            "description": "表示するコード。npm run test:snippets で実行し、標準出力が answer と一致することを確かめる",
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "description": "正解の出力（各行の末尾の空白と最後の改行は比べない）",
            "type": "string"
          },
          "choices": {
            "description": "誤答の選択肢（3 つ）。正解・ほかの選択肢と同じ出力にしない",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output"],
              "properties": {
                "output": { "type": "string" },
                "note": {
                  "description": "よくある勘違いの説明（この選択肢を選んだときに表示する）",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "explanation": {
            "description": "なぜその答えになるか（どこでどう値が変わるか）",
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "description": "関連する技術用語図鑑の用語 ID（content/glossary）。回答すると図鑑で発見済みになる",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
