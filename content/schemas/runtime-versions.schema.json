{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime-versions.schema.json",
  "title": "実行環境の主な版とサポート終了日（docs/11-v090-runtime-guide.md 2.3。型は src/features/runtime-guide/versions.ts）",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewed", "products"],
  "properties": {
    "version": { "const": 1 },
    "reviewed": {
      "description": "最後に見直した日（YYYY-MM-DD）。YAML では日付として読まれないよう引用符で囲む",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "source", "security", "recommended", "branches"],
        "properties": {
          "id": { "enum": ["node", "java", "tomcat", "nginx", "spring-boot"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "source": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "security": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "recommended": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
          "unlistedEnded": { "type": "boolean" },
          "note": { "type": "string", "minLength": 1, "maxLength": 300 },
          "branches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
                "eol": {
                  "description": "サポート終了日（YYYY-MM-DD、または月まで YYYY-MM）",
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
                },
                "atLeast": { "type": "boolean" },
                "eolUnknown": { "const": true },
                "ended": { "const": true },
                "note": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      }
    }
  }
}
