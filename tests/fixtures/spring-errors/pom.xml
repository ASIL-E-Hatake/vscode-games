<?xml version="1.0" encoding="UTF-8"?>
<!--
  L2（Spring Boot の起動エラー）の検査専用の最小の Spring Boot アプリ（Maven）。scripts/spring-errors-e2e.ts が使う。vsix には入らない。
  エラーメッセージ辞書（content/errors/spring-boot.yaml）の例を、このアプリに当ててわざと起動に失敗させ、実際のメッセージと照合する。
  - JPA を入れているのは、起動時に DB へ接続させるため（接続の失敗が起動のエラーとして出る。実際のアプリに近い）
  - javax.servlet-api は provided（コンパイルだけに使い、実行時のクラスパスには入れない）。
    「ClassNotFoundException / NoClassDefFoundError（版ずれ）」の例で、古い javax のクラスが実行時に無い状態を作る
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>spring-errors</artifactId>
  <version>0.0.1</version>
  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
