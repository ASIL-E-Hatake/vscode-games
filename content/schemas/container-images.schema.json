{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "container-images.schema.json",
  "title": "コンテナのベースイメージと版（docs/10-container-tools.md 3.3。型は src/core/containerImages.ts）",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewed", "images"],
  "properties": {
    "version": { "const": 1 },
    "reviewed": {
      "description": "最後に版を見直した日（YYYY-MM-DD）。YAML では日付として読まれないよう引用符で囲む",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "versions": {
            "description": "版 → イメージ名:タグ。タグはメジャーバージョンまで（例: eclipse-temurin:21-jre）。版が 1 つなら default を使う",
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,19}$" },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "defaultVersion": { "type": "string" },
          "note": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
