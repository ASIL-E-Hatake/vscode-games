{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "linux-commands.schema.json",
  "title": "Linux コマンド辞書",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "summary", "syntax", "examples"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "category": {
            "enum": ["file", "text", "permission", "process", "network", "archive", "system"]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 80 },
          "syntax": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["flag", "description"],
              "properties": {
                "flag": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "description"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "related": { "type": "array", "items": { "type": "string" } },
          "danger": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
