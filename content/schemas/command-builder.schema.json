{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-builder.schema.json",
  "title": "コマンド組み立てのひな形（docs/07-tool-generators.md 4 章）",
  "type": "object",
  "additionalProperties": false,
  "required": ["tab", "category", "label", "templates"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tab": {
      "enum": ["linux", "git", "curl", "docker", "build"]
    },
    "category": {
      "$ref": "#/definitions/id"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "order": {
      "type": "integer"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/template"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "paramId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/definitions/paramId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["param"],
          "properties": {
            "param": {
              "$ref": "#/definitions/paramId"
            },
            "equals": {
              "type": "string"
            },
            "notEmpty": {
              "type": "boolean"
            },
            "endsWith": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            },
            "not": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "explain": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "$ref": "#/definitions/condition"
            },
            "join": {
              "type": "boolean"
            },
            "show": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["param"],
          "properties": {
            "param": {
              "$ref": "#/definitions/paramId"
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "quote": {
              "enum": ["auto", "always"]
            },
            "glob": {
              "type": "boolean"
            },
            "explain": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "$ref": "#/definitions/condition"
            },
            "join": {
              "type": "boolean"
            },
            "show": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format"],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "enum": ["auto", "always"]
            },
            "explain": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "$ref": "#/definitions/condition"
            },
            "join": {
              "type": "boolean"
            },
            "show": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/part"
      }
    },
    "shellParts": {
      "oneOf": [
        {
          "$ref": "#/definitions/parts"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unsupported"],
          "properties": {
            "unsupported": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "params"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "danger": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "type"],
            "properties": {
              "id": {
                "$ref": "#/definitions/paramId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "type": {
                "enum": ["text", "path", "number", "flag", "select"]
              },
              "required": {
                "type": "boolean"
              },
              "placeholder": {
                "type": "string"
              },
              "default": {
                "$ref": "#/definitions/value"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label"],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "danger": {
                "type": "boolean"
              },
              "help": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "shells": {
          "$ref": "#/definitions/shells"
        },
        "warnings": {
          "$ref": "#/definitions/warnings"
        },
        "examples": {
          "$ref": "#/definitions/examples"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/variant"
          }
        }
      },
      "oneOf": [
        {
          "required": ["shells", "examples"],
          "not": {
            "required": ["variants"]
          }
        },
        {
          "required": ["variants"],
          "not": {
            "anyOf": [
              {
                "required": ["shells"]
              },
              {
                "required": ["examples"]
              }
            ]
          }
        }
      ]
    },
    "shells": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bash": {
          "$ref": "#/definitions/shellParts"
        },
        "powershell": {
          "$ref": "#/definitions/shellParts"
        },
        "all": {
          "$ref": "#/definitions/parts"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "when": {
            "$ref": "#/definitions/condition"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "shell": {
            "enum": ["bash", "powershell"]
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/value"
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "bash": {
                "type": "string",
                "minLength": 1
              },
              "powershell": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "shells": {
          "$ref": "#/definitions/shells"
        },
        "unsupported": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "$ref": "#/definitions/warnings"
        },
        "examples": {
          "$ref": "#/definitions/examples"
        }
      },
      "oneOf": [
        {
          "required": ["shells", "examples"],
          "not": {
            "required": ["unsupported"]
          }
        },
        {
          "required": ["unsupported"],
          "not": {
            "anyOf": [
              {
                "required": ["shells"]
              },
              {
                "required": ["examples"]
              }
            ]
          }
        }
      ]
    }
  }
}
