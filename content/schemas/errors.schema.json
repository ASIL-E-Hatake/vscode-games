{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "errors.schema.json",
  "title": "エラーメッセージ辞書（言語ごとに 1 ファイル）",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "errors"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "language": {
      "enum": ["java", "python", "javascript", "ruby", "spring-boot"]
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "patterns", "summary", "causes", "checks", "example"],
        "properties": {
          "id": {
            "description": "<言語>-<内容>（例: java-null-pointer）",
            "type": "string",
            "pattern": "^(java|python|javascript|ruby|spring-boot)(-[a-z0-9]+)+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "patterns": {
            "description": "実際のエラーメッセージに含まれる部分。貼り付けた文との照合に使う",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "causes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "example": {
            "description": "そのエラーが実際に出る短いコード（npm run test:snippets で実行して確かめる）",
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "description": "example を実行したときの出力に含まれる文字列",
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "description": "関連する技術用語図鑑の用語 ID（content/glossary）。エラーを開くと図鑑で発見済みになる",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "spring": {
            "description": "Spring Boot の例を L2（npm run test:spring-errors）で実際に起動して確かめるときの壊し方（検査専用。画面・dist には出さない。型は src/features/error-dict/types.ts の SpringErrorRun）",
            "type": "object",
            "additionalProperties": false,
            "required": ["place"],
            "properties": {
              "place": {
                "description": "example の使い方。java: アプリのコードとして入れる / properties: application.properties として読む / none: 使わない",
                "enum": ["java", "properties", "none"]
              },
              "base": {
                "description": "false なら tests/fixtures/spring-errors/base.properties（PostgreSQL への接続）を読まない",
                "type": "boolean"
              },
              "java": {
                "description": "実行する Java の版（content/container/images.yaml の temurin-jre の版）",
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "occupyPort": {
                "description": "起動の前に、同じポートで別のアプリを動かしておく",
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "properties": {
                "description": "example のほかに読む設定（画面には出さない）",
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Spring Boot の例は実際に起動して確かめるため spring と expect が必須。ほかの言語では spring を書かない",
      "if": {
        "properties": {
          "language": {
            "const": "spring-boot"
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "items": {
              "required": ["spring", "expect"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "items": {
              "not": {
                "required": ["spring"]
              }
            }
          }
        }
      }
    }
  ]
}
