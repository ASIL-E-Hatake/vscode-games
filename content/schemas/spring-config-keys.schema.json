{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spring-config-keys.schema.json",
  "title": "Spring Boot の設定変換で、環境変数の名前から推測するときに使うよく使うキー（src/features/spring-config/knownKeys.ts）",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(-[a-z0-9_]+)*(\\.[a-z][a-z0-9_]*(-[a-z0-9_]+)*)*$",
        "maxLength": 100
      }
    }
  }
}
