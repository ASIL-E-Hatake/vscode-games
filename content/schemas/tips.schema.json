{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tips.schema.json",
  "title": "今日のひとこと（Tips）",
  "type": "object",
  "additionalProperties": false,
  "required": ["tips"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "tips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "category": { "enum": ["vscode", "linux", "git", "programming"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "keys": {
            "description": "関係するショートカット（Windows / Linux 表記）",
            "type": "string"
          }
        }
      }
    }
  }
}
