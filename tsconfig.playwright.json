{
  // L3 Webview 画面テスト・L6 E2E（Playwright）
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "tests/webview/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/shared/**/*.ts",
    "playwright.*.config.ts"
  ],
  // テスト専用のゲーム（Webview 側のコード）は tsconfig.webview.json で検査する
  "exclude": ["tests/webview/game-kit-test/**", "tests/webview/quiz-kit-test/**"]
}
