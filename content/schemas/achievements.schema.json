{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "achievements.schema.json",
  "title": "ゲーム内実績（docs/08-keep-playing.md）",
  "type": "object",
  "additionalProperties": false,
  "required": ["achievements"],
  "definitions": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counter", "atLeast"],
      "properties": {
        "counter": {
          "description": "出来事のカウンター名（src/core/counters.ts）。末尾を「.*」にすると、その接頭辞で始まるカウンターをまとめる",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*(\\.\\*)?$",
          "maxLength": 98
        },
        "atLeast": { "type": "integer", "minimum": 1 },
        "aggregate": {
          "description": "末尾「.*」のときの集計: sum（合計。既定）/ count（値が 1 以上のカウンターの数）",
          "enum": ["sum", "count"]
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/condition" }
    }
  },
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "anyOf": [{ "required": ["all"] }, { "required": ["any"] }],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "minLength": 1, "maxLength": 120 },
          "hint": {
            "description": "未獲得のときに見せる条件のヒント（省略時は description）",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": { "enum": ["game", "reference", "daily", "explore"] },
          "icon": { "description": "codicon 名", "type": "string", "pattern": "^[a-z0-9-]+$" },
          "secret": {
            "description": "true なら未獲得のあいだ名前とヒントを隠す",
            "type": "boolean"
          },
          "all": { "$ref": "#/definitions/conditions" },
          "any": { "$ref": "#/definitions/conditions" }
        }
      }
    }
  }
}
