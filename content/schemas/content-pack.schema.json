{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content-pack.schema.json",
  "title": "問題パック（1 ファイル = 1 パック。同梱の問題と同じ形で、問題ごとに language を書く）。docs/06-content-pack.md",
  "description": "拡張機能は実行時にこのスキーマと同じ条件を src/core/contentPackValidate.ts で確かめ、不正な問題だけを読み飛ばす（scripts/content-pack.test.ts で食い違いを検査）",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["outputQuiz"] },
    { "required": ["bugHunt"] },
    { "required": ["typing"] }
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": {
      "description": "パックの名前（省略時はファイル名）。問題 ID の前に付く（pack:<名前>:<ID>）",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "\\S"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "outputQuiz": {
      "description": "出力当てクイズの問題（content/output-quiz と同じ形 + language）",
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/definitions/outputQuestion" }
    },
    "bugHunt": {
      "description": "バグ探しの問題（content/bug-hunt と同じ形 + language。fix は省略可で、書いても画面には出さない）",
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/definitions/bugQuestion" }
    },
    "typing": {
      "description": "コードタイピングのお題（言語ごと）。パックのお題はモード「問題パック」で全言語まとめて出る",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "java": { "$ref": "#/definitions/snippets" },
        "python": { "$ref": "#/definitions/snippets" },
        "javascript": { "$ref": "#/definitions/snippets" },
        "ruby": { "$ref": "#/definitions/snippets" },
        "linux": { "$ref": "#/definitions/snippets" }
      }
    }
  },
  "definitions": {
    "id": {
      "description": "パックの中で一意な ID（例: loop-sum）",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
    "code": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "language": { "enum": ["java", "python", "javascript", "ruby"] },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "terms": {
      "description": "技術用語図鑑の用語 ID（形式だけ確かめる。パックの問題では使わない）",
      "type": "array",
      "items": { "type": "string" }
    },
    "lineMap": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^[1-9][0-9]*$": { "type": "string" } }
    },
    "outputQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "title",
        "difficulty",
        "code",
        "answer",
        "choices",
        "explanation"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "language": { "$ref": "#/definitions/language" },
        "title": { "$ref": "#/definitions/title" },
        "difficulty": { "$ref": "#/definitions/difficulty" },
        "code": { "$ref": "#/definitions/code" },
        "answer": { "type": "string", "maxLength": 2000 },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output"],
            "properties": {
              "output": { "type": "string" },
              "note": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        },
        "explanation": { "$ref": "#/definitions/text" },
        "terms": { "$ref": "#/definitions/terms" }
      }
    },
    "bugQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "title",
        "difficulty",
        "intent",
        "code",
        "expected",
        "bugLines",
        "explanation"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "language": { "$ref": "#/definitions/language" },
        "title": { "$ref": "#/definitions/title" },
        "difficulty": { "$ref": "#/definitions/difficulty" },
        "intent": { "$ref": "#/definitions/text" },
        "code": { "$ref": "#/definitions/code" },
        "expected": { "type": "string", "maxLength": 2000 },
        "bugLines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "lineNotes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^[1-9][0-9]*$": { "$ref": "#/definitions/text" } }
        },
        "fix": { "$ref": "#/definitions/lineMap" },
        "explanation": { "$ref": "#/definitions/text" },
        "terms": { "$ref": "#/definitions/terms" }
      }
    },
    "snippets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 60,
        "pattern": "^[!-~]([ -~]*[!-~])?$"
      }
    }
  }
}
