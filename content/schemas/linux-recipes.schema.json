{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "linux-recipes.schema.json",
  "title": "忘れがち Linux コマンド集（やりたいことから引くレシピ）",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "situation", "command", "explanation", "pitfall"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "category": {
            "enum": [
              "archive",
              "search",
              "link-permission",
              "disk",
              "process",
              "text",
              "remote",
              "other"
            ]
          },
          "situation": { "type": "string", "minLength": 1, "maxLength": 60 },
          "command": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "pitfall": { "type": "string", "minLength": 1 },
          "related": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
